class Solution:
    def isPrime(self, n):
        # code here
        if n <= 1:
            return False
        if n <= 3:
            return True          # 2 and 3 are prime
        if n % 2 == 0 or n % 3 == 0:
            return False
        
        # Check divisors of the form 6k ± 1 up to sqrt(n)
        i = 5
        while i * i <= n:
            if n % i == 0 or n % (i + 2) == 0:
                return False
            i += 6
        return True
