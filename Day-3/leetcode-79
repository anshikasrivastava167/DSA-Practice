class Solution:
    def exist(self, board: List[List[str]], word: str) -> bool:
        rows = len(board)
        cols = len(board[0])
        
        for r in range(rows):
            for c in range(cols):
                if self.dfs(board, word, r, c, 0):
                    return True
        return False
    
    def dfs(self, board, word, r, c, index):
        if index == len(word):
            return True  
        
        if (r < 0 or r >= len(board) or c < 0 or c >= len(board[0])
                or board[r][c] != word[index]):
            return False
        
        temp = board[r][c]
        board[r][c] = '#'  
        
        found = (self.dfs(board, word, r + 1, c, index + 1)
                 or self.dfs(board, word, r - 1, c, index + 1)
                 or self.dfs(board, word, r, c + 1, index + 1)
                 or self.dfs(board, word, r, c - 1, index + 1))
        
        board[r][c] = temp  
        
        return found
