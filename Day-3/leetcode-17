class Solution:
    def letterCombinations(self, digits: str) -> List[str]:
        result = []
        if digits is None or len(digits) == 0:
            return result
        
        mapping = [
            "",     
            "",     
            "abc",  
            "def",  
            "ghi",  
            "jkl",  
            "mno",  
            "pqrs", 
            "tuv",  
            "wxyz"  
        ]
        
        path = []
        self.backtrack(digits, 0, mapping, path, result)
        return result
    
    def backtrack(self, digits, index, mapping, path, result):
        if index == len(digits):
            result.append("".join(path))
            return
        
        digit = int(digits[index])
        letters = mapping[digit]
        
        for c in letters:
            path.append(c)
            self.backtrack(digits, index + 1, mapping, path, result)
            path.pop()  
