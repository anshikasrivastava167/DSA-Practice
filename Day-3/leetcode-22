class Solution:
    def generateParenthesis(self, n):
        result = []

        def backtrack(open, close, current):
            if len(current) == 2 * n:
                result.append(current)
                return

            if open < n:
                backtrack(open + 1, close, current + "(")

            if close < open:
                backtrack(open, close + 1, current + ")")

        backtrack(0, 0, "")

        return result
